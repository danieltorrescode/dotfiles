# uncomment the line above to set to yes force_color_prompt=yes
# default .bashrc config files at /etc/skel/

alias SO="systemctl poweroff"
alias SR="systemctl reboot"
alias SS="systemctl suspend"
alias SH="systemctl hibernate"
alias SSH="systemctl suspend-then-hibernate"

alias ll='lsd -lh --group-dirs=first'
alias la='lsd -a --group-dirs=first'
alias l='lsd --group-dirs=first'
alias lla='lsd -lha --group-dirs=first'
alias ls='lsd --group-dirs=first'
alias cat='bat'

bind 'set show-all-if-ambiguous on'
bind 'TAB:menu-complete'
#uname -a
#fastfetch

#[ -f ~/.fzf.bash ] && source ~/.fzf.bash
#[ -f /usr/bin/fzf ]
source /usr/share/fzf/completion.bash
source /usr/share/fzf/key-bindings.bash
export FZF_DEFAULT_OPTS="--extended"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Starship Prompt
eval "$(starship init bash)"

export PATH=$NODE_HOME/bin:$PATH
export PATH="$HOME/.npm-global/bin:$PATH"

# vterm integration with Zsh / Bash
vterm_printf() {
    if [ -n "$TMUX" ] || [ "${TERM%%-*}" = "tmux" ]; then
        # Tell tmux to pass the sequence through
        printf "\ePtmux;\e\e]%s\007\e\\" "$1"
    elif [ "${TERM%%-*}" = "screen" ]; then
        # GNU Screen (screen, screen-256color, screen-256color-bce)
        printf "\eP\e]%s\007\e\\" "$1"
    else
        printf "\e]%s\007" "$1"
    fi
}

# Sync the current working directory (PWD) with the Emacs buffer
vterm_prompt_end() {
    vterm_printf "51;A$(whoami)@$(hostname):$(pwd)";
}
PS1=$PS1'$(vterm_prompt_end)'